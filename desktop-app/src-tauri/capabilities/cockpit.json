{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cockpit",
  "description": "Local Cockpit window only (no `remote` block => the remote CRM origin gets no IPC, and no agent command).",
  "local": true,
  "windows": [
    "cockpit"
  ],
  "permissions": [
    "allow-agent-run",
    "allow-agent-cancel",
    "allow-agent-trace",
    "allow-agent-settings-get",
    "allow-agent-settings-set",
    "allow-crm-session-status",
    "allow-open-cockpit",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
